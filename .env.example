# Copia este archivo a .env. Lo único obligatorio es DISCORD_TOKEN; el resto trae
# el valor por defecto de core/config.py (el que aparece aquí) y se descomenta solo
# si hay que cambiarlo. Los mismos grupos y el mismo orden que la tabla del README.

# --- Discord -------------------------------------------------------------------
DISCORD_TOKEN=tu_token_aqui
# Prefijo de los comandos.
# PREFIX=!
# Servidores donde el bot puede funcionar: IDs separados por comas o espacios.
# Vacía (o sin definir) no restringe nada: el bot acepta cualquier servidor. Con
# IDs, se va de los servidores nuevos que no estén y en los demás ignora los
# comandos (los que ya estaban no los abandona; solo avisa en el log). Conviene
# además desactivar "Public Bot" en el Portal de desarrolladores de Discord
# (pestaña Bot): así nadie más puede invitarlo.
# SERVIDORES_PERMITIDOS=123456789012345678,987654321098765432

# --- Lavalink y API local ------------------------------------------------------
# La contraseña también está en scripts/lavalink/application.yml: cámbiala en los dos.
# LAVALINK_URI=http://127.0.0.1:2333
# LAVALINK_PASSWORD=youshallnotpass
# Puerto de la API de los paneles (siempre escucha solo en 127.0.0.1).
# API_PORT=9876

# --- YouTube y yt-dlp ----------------------------------------------------------
# El audio de YouTube lo resuelve yt-dlp (el plugin de Lavalink ya no puede).
# Por defecto se busca en el PATH, junto al python del venv y en ~/.local/bin/yt-dlp.
# YTDLP_BIN=/ruta/a/yt-dlp
# Cliente de YouTube que usa yt-dlp. Si deja de haber audio el bot cambia solo, pero
# hasta que reinicies: para fijarlo, pon aquí el que indique el log.
# YTDLP_PLAYER_CLIENT=android
# Clientes que el bot prueba, en orden y separados por comas, cuando el actual falla.
# YTDLP_CLIENTES=android,android_vr,ios,mweb,web,tv_simply,web_embedded
# Actualizar yt-dlp solo cuando tiene más de 30 días o ningún cliente suena. Con
# false solo avisa en el log y en los paneles.
# YTDLP_AUTOACTUALIZAR=true
# Segundos que se le aguantan a yt-dlp por canción.
# YTDLP_TIMEOUT=30
# Segundos al aire, con cola y sin que arranque ninguna canción, para dar el bot
# por mudo.
# SILENCIO_PARA_MUDO=300

# --- DJ y guionista ------------------------------------------------------------
# Volumen inicial de la voz del DJ, 0-200 (100 = su nivel de siempre, 0 = mudo).
# El fader del panel GTK lo pisa con su última posición apenas levanta el bot.
# DJ_VOLUME=100
# Quién escribe lo que dice el DJ: frases (su banco, sin costo), claude (API de
# Anthropic, cobra por uso) u ollama (modelo local, gratis). Lo que se elige desde
# el panel web gana sobre este valor.
# DJ_GUIONISTA=frases
# Con claude: la credencial (la lee el SDK de Anthropic, no core/config.py; también
# sirve un perfil de `ant auth login`) y el modelo. claude-haiku-5-5 es más barato.
# ANTHROPIC_API_KEY=tu_clave_aqui
# DJ_GUIONISTA_MODELO=claude-opus-5-5
# Con ollama: dónde corre y qué modelo usar (ollama pull llama3.2:3b).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELO=llama3.2:3b

# --- SponsorBlock --------------------------------------------------------------
# Saltar de los videoclips lo que no es la canción (intros habladas, sketches,
# finales) con las marcas públicas de SponsorBlock; no necesita cuenta.
# SPONSORBLOCK=true
# Categorías de SponsorBlock que se saltan, separadas por comas.
# SPONSORBLOCK_CATEGORIAS=music_offtopic

# --- Colas y autoplay ----------------------------------------------------------
# Tope de la cola y cuánto se toma de una playlist de una vez.
# QUEUE_LIMIT=500
# PLAYLIST_LIMIT=100
# Autoplay: al vaciarse la cola, seguir con temas parecidos.
# AUTOPLAY_DEFAULT=true
# Canciones seguidas con el canal sin humanos antes de cortar la transmisión.
# INACTIVE_CHANNEL_TOKENS=3
# Segundos sin música antes de irse del canal.
# IDLE_TIMEOUT=300
