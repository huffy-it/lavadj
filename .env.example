# Lo único obligatorio.
DISCORD_TOKEN=tu_token_aqui

# El resto tiene valores por defecto razonables en core/config.py; se descomenta
# solo si hay que cambiarlos.
# PREFIX=!
# LAVALINK_URI=http://127.0.0.1:2333
# LAVALINK_PASSWORD=youshallnotpass
# API_PORT=9876

# Tope de la cola y cuánto se toma de una playlist de una vez.
# QUEUE_LIMIT=500
# PLAYLIST_LIMIT=100

# Autoplay: al vaciarse la cola, seguir con temas parecidos.
# AUTOPLAY_DEFAULT=true
# Canciones seguidas con el canal vacío antes de cortar la transmisión.
# INACTIVE_CHANNEL_TOKENS=3
# Segundos sin música antes de irse del canal.
# IDLE_TIMEOUT=300

# Volumen inicial de la voz del DJ, 0-200 (100 = su nivel de siempre, 0 = mudo).
# El fader del panel de escritorio lo pisa apenas levanta el bot.
# DJ_VOLUME=100

# El audio de YouTube lo resuelve yt-dlp (el plugin de Lavalink ya no puede).
# Por defecto se busca en el PATH, en el venv y, si no está, en ~/.local/bin/yt-dlp.
# YTDLP_BIN=/ruta/a/yt-dlp
# Cliente de YouTube que usa yt-dlp. Si deja de haber audio, se sondean los
# otros (ver AGENTS.md) y se cambia aquí: android_vr, ios, mweb, web...
# YTDLP_PLAYER_CLIENT=android
# Segundos que se le aguantan a yt-dlp por canción.
# YTDLP_TIMEOUT=30

# Segundos al aire, con cola y sin que arranque ninguna canción, para dar el bot
# por mudo.
# SILENCIO_PARA_MUDO=300
